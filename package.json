{
  "name": "outlook-calendar-viewer",
  "displayName": "Outlook Calendar & Email Viewer",
  "description": "View your Microsoft Outlook calendar events and emails directly in VS Code. Simple, secure, and seamless.",
  "version": "1.1.1",
  "publisher": "Gururagavendra",
  "author": {
    "name": "Gururagavendra"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Gururagavendra/vscode-calendar-viewer"
  },
  "bugs": {
    "url": "https://github.com/Gururagavendra/vscode-calendar-viewer/issues"
  },
  "homepage": "https://github.com/Gururagavendra/vscode-calendar-viewer#readme",
  "keywords": [
    "outlook",
    "calendar",
    "microsoft",
    "graph",
    "oauth",
    "events",
    "schedule"
  ],
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "outlook-calendar",
          "title": "Outlook Calendar",
          "icon": "$(calendar)"
        }
      ]
    },
    "views": {
      "outlook-calendar": [
        {
          "id": "outlookWelcome",
          "name": "Welcome",
          "when": "!outlookCalendar.authenticated"
        },
        {
          "id": "outlookCalendar",
          "name": "Upcoming Events",
          "when": "outlookCalendar.authenticated"
        },
        {
          "id": "outlookEmail",
          "name": "Inbox",
          "when": "outlookCalendar.authenticated"
        }
      ]
    },
    "commands": [
      {
        "command": "outlook-calendar.authenticate",
        "title": "Sign In",
        "category": "Outlook Calendar",
        "icon": "$(sign-in)"
      },
      {
        "command": "outlook-calendar.fetchEvents",
        "title": "Fetch Calendar Events",
        "category": "Outlook Calendar"
      },
      {
        "command": "outlook-calendar.refresh",
        "title": "Refresh",
        "category": "Outlook Calendar",
        "icon": "$(refresh)"
      },
      {
        "command": "outlook-email.fetchEmails",
        "title": "Fetch Emails",
        "category": "Outlook Email"
      },
      {
        "command": "outlook-email.refresh",
        "title": "Refresh",
        "category": "Outlook Email",
        "icon": "$(refresh)"
      },
      {
        "command": "outlook-email.fetchUnread",
        "title": "Show Unread Only",
        "category": "Outlook Email",
        "icon": "$(mail)"
      },
      {
        "command": "outlook-email.openEmail",
        "title": "Open in Outlook Web",
        "category": "Outlook Email",
        "icon": "$(link-external)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "outlook-calendar.authenticate",
          "when": "view == outlookCalendar",
          "group": "navigation@1"
        },
        {
          "command": "outlook-calendar.refresh",
          "when": "view == outlookCalendar",
          "group": "navigation@2"
        },
        {
          "command": "outlook-email.refresh",
          "when": "view == outlookEmail",
          "group": "navigation@1"
        },
        {
          "command": "outlook-email.fetchUnread",
          "when": "view == outlookEmail",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "outlook-email.openEmail",
          "when": "view == outlookEmail && viewItem =~ /Email/",
          "group": "inline"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "outlookWelcome",
        "contents": "Sign in to view your Outlook calendar and emails.\n[$(sign-in) Sign In with Microsoft](command:outlook-calendar.authenticate)\nAfter signing in, your calendar events and inbox will appear below."
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.x",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "@azure/identity": "^4.13.0",
    "@azure/msal-node": "^3.8.3",
    "axios": "^1.6.0"
  }
}
